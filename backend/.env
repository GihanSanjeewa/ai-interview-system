# --- Server ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# --- Database ---
DATABASE_URL="mysql://root:@localhost:3306/ai_interview_system"
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=ai_interview_system

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-please
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_COST=12

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- ML services ---
ML_SERVICE_URL=http://localhost:8000

# --- Upload ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
